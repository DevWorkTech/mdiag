{
  "name": "devworktech/mdiag-dwt",
  "description": "Изолированный Laravel-компонент LAN gateway и локального репозитория диагностических пакетов",
  "type": "library",
  "license": "proprietary",
  "keywords": [
    "laravel",
    "diagnostics",
    "lan",
    "gateway"
  ],
  "require": {
    "php": "^8.2",
    "ext-soap": "*",
    "guzzlehttp/guzzle": "^7.8",
    "illuminate/cache": "^11.0|^12.0",
    "illuminate/console": "^11.0|^12.0",
    "illuminate/database": "^11.0|^12.0",
    "illuminate/filesystem": "^11.0|^12.0",
    "illuminate/http": "^11.0|^12.0",
    "illuminate/routing": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "illuminate/hashing": "^11.0|^12.0",
    "illuminate/encryption": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "DevWorkTech\\MDiag\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DevWorkTech\\MDiag\\MDiagServiceProvider"
      ]
    }
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "DevWorkTech\\MDiag\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
